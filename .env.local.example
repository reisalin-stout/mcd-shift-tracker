# Copy this file to .env.local (git-ignored) and fill in the values. ONE file for everything private or per-machine.
# Vite reads it for the app (only VITE_ keys reach the browser); the importer (npm run update) reads the rest.
# `npm run build` / `npm run update` regenerate THIS template from .env.local (values blanked, comments kept).

# --- Firebase web config: Firebase Console > Project settings > Your apps ---
# Not secret (it ships inside the site); access is protected by database.rules.json, not by hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Login: people type "sa-luca", the app signs in as sa-luca@<this domain> ---
VITE_AUTH_EMAIL_DOMAIN=shift.local

# --- Importer (dev/importer, `npm run update`): never reaches the browser (no VITE_ prefix) ---
# Id of the Google Sheet (the long part of its URL)
SPREADSHEET_ID=
# true: keep the downloaded CSVs in dev/importer/temp after a successful run
IMPORT_KEEP_TEMP=
# true: do not download, parse the CSVs already in dev/importer/temp
IMPORT_SKIP_DOWNLOAD=
# true: do not update the Dictionary tab of the Google Sheet (the local database.json is still written)
IMPORT_SKIP_UPLOAD=
